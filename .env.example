# Copy to .env.local for local development. Never commit real values.
# In production, set these as SENSITIVE environment variables in Vercel so the
# value is write-only and never shows up in logs or the dashboard UI.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin of the deployed site, no trailing slash. Read by
# lib/site.ts for metadataBase, canonical URLs, and the structured data.
# Optional on Vercel: when unset, the project's production URL
# (VERCEL_PROJECT_PRODUCTION_URL, which Vercel sets automatically) is used,
# and locally it falls back to http://localhost:3000. Set it once the custom
# domain is attached so the canonical URL is the domain, not the *.vercel.app
# alias.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Email (the consultation form, delivered through Resend)
# ---------------------------------------------------------------------------
# Required in production. Without it POST /api/h1-consultation returns
# { code: "email_not_configured" } and the form shows an error.
RESEND_API_KEY=

# Sender. Until a domain is verified in Resend, only the account's own address
# can send, and only to the account's own address; every other combination is
# refused and the form fails. Verify a domain in Resend, then set these.
CONTACT_FROM_EMAIL=noreply@leeenterprisesunlimited.com

# Where consultation requests deliver. H1_TO_EMAIL wins when set; otherwise
# CONTACT_TO_EMAIL; otherwise ceo@leeenterprisesunlimited.com. Both optional
# and unset on purpose: H1 leads land in the same Lee Enterprises inbox as the
# parent site's forms, distinguishable by subject line ("New H1 Consultation
# Request"). Set H1_TO_EMAIL only to route them somewhere else.
CONTACT_TO_EMAIL=ceo@leeenterprisesunlimited.com
H1_TO_EMAIL=
